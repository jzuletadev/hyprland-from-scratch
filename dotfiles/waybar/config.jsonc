// ~/hyprland-from-scratch/dotfiles/waybar/config.jsonc

{
    "layer": "top",
    "position": "top",
    "height": 35,
    "spacing": 0,
    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "mpris"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "custom/recording",
        "group/status",
        "clock"
    ],
    "custom/arch": {
        "format": "\uf303",
        "tooltip-format": "Click: system info \u00b7 Right-click: settings\nApps: tap SUPER \u00b7 Help: SUPER + /",
        "on-click": "~/hyprland-from-scratch/scripts/sysinfo.sh",
        "on-click-right": "kitty --class theme-floating -e python3 ~/hyprland-from-scratch/scripts/theme-tui.py"
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },
    "mpris": {
        "format": " \uf001  {title}",
        "format-paused": "",
        "format-stopped": "",
        "max-length": 25,
        "tooltip-format": "{player}: {artist} - {title}"
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true
    },
    "custom/recording": {
        "exec": "~/hyprland-from-scratch/scripts/waybar-recording.sh",
        "return-type": "json",
        "interval": 1,
        "signal": 9,
        "on-click": "python3 ~/hyprland-from-scratch/scripts/screen-record-tui.py stop"
    },
    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "group/brightness",
            "network",
            "group/volume",
            "custom/bluetooth",
            "battery"
        ]
    },
    "group/brightness": {
        "orientation": "horizontal",
        "modules": [
            "backlight"
        ]
    },
    "backlight": {
        "device": "amdgpu_bl1",
        "format": "\uf185 {percent}%",
        "tooltip-format": "Laptop screen: {percent}%\nHover: slider · Scroll: ±5%",
        "on-scroll-up": "brightnessctl -d amdgpu_bl1 set 5%+",
        "on-scroll-down": "brightnessctl -d amdgpu_bl1 set 5%-",
        "on-click": "kitty --class brightness-floating -e python3 ~/hyprland-from-scratch/scripts/brightness-tui.py"
    },
    "network": {
        "format-wifi": "\uf1eb  {essid}",
        "format-ethernet": "\uf108  {ifname}",
        "format-disconnected": "\uf071  disconnected",
        "tooltip-format-wifi": "Wi-Fi: {essid} ({signalStrength}%)\n{ipaddr} via {gwaddr}\nClick: network menu",
        "tooltip-format-ethernet": "Wired: {ifname}\n{ipaddr} via {gwaddr}\nClick: network menu",
        "tooltip-format-disconnected": "Disconnected\nClick: network menu",
        "on-click": "kitty --class wifi-floating -e python3 ~/hyprland-from-scratch/scripts/wifi-tui.py"
    },
    "group/volume": {
        "orientation": "horizontal",
        "modules": [
            "wireplumber"
        ],
        "on-click": "kitty --class volume-floating -e python3 ~/hyprland-from-scratch/scripts/volume-tui.py"
    },
    "wireplumber": {
        "format": "{icon}  {volume}%",
        "format-muted": "\uf026  muted",
        "format-icons": [
            "\uf026",
            "\uf027",
            "\uf028"
        ],
        "scroll-step": 5,
        "tooltip-format": "{node_name}: {volume}%\nClick: audio menu \u00b7 Right-click: mute \u00b7 Scroll: \u00b15%",
        "on-click": "kitty --class volume-floating -e python3 ~/hyprland-from-scratch/scripts/volume-tui.py",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/bluetooth": {
        "exec": "~/hyprland-from-scratch/scripts/waybar-bluetooth.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "kitty --class bluetooth-floating -e python3 ~/hyprland-from-scratch/scripts/bluetooth-tui.py"
    },
    "battery": {
        "format": "{icon}  {capacity}%",
        "format-icons": [
            "\uf244",
            "\uf243",
            "\uf242",
            "\uf241",
            "\uf240"
        ],
        "format-charging": "\uf0e7  {capacity}%",
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format-time": "{H}h {M}min",
        "tooltip-format": "{capacity}% \u00b7 {timeTo}\nPower draw: {power:.1f} W\nHealth: {health}% of design capacity",
        "on-click": "kitty --class power-floating -e python3 ~/hyprland-from-scratch/scripts/power-profile-tui.py"
    },
    "clock": {
        "format": "\uf017 {:%H:%M   \uf133  %d %b %Y}",
        "on-click": "kitty --class calendar-floating -e python3 ~/hyprland-from-scratch/scripts/calendar-tui.py",
        "tooltip-format": "{:%A, %d %B %Y}\nClick: calendar"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\uf06e",
            "deactivated": "\uf070"
        },
        "tooltip-format-activated": "Idle management paused (hypridle won't dim/lock/suspend)",
        "tooltip-format-deactivated": "Idle management active"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nClick: next \u00b7 Right-click: previous",
        "tooltip": true,
        "format-icons": {
            "default": "\uf0e7",
            "performance": "\uf0e7",
            "balanced": "\uf24e",
            "power-saver": "\uf06c"
        }
    },
    "tray": {
        "spacing": 8
    }
}