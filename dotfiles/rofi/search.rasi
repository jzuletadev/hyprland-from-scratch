// ~/hyprland-from-scratch/dotfiles/rofi/search.rasi

@import "config.rasi"

configuration {
    drun-match-fields: "name,generic,keywords";
    sort: true;
    sorting-method: "fzf";
}

window {
    width: 20%;
    location: north;
    anchor: north;
    y-offset: 60%;
}

mainbox {
    children: [ "inputbar", "listview" ];
}

listview {
    lines: 6;
    require-input: true;
    fixed-height: false;
}
