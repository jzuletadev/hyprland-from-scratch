// ~/hyprland-from-scratch/dotfiles/rofi/menu.rasi

@import "config.rasi"

window {
    width: 20%;
}

mainbox {
    children: [ "inputbar", "listview" ];
}

inputbar {
    spacing: 5px;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
}

entry {
    placeholder: "Filter...";
}

listview {
    lines: 12;
    fixed-height: false;
}
