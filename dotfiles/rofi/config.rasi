// ~/hyprland-from-scratch/dotfiles/rofi/config.rasi
//
// Minimal Rofi config — Phase 4 baseline, themed in Phase 10, re-themed in Phase 15 (Arch Neutral),
// mode-switcher row added in Phase 11, hover-select in Phase 18. Apps/run/files/windows, all built
// into Rofi — no extra modi packages needed. Phase 13: translucent window
// (frosted by Hyprland's "layerrule = blur on, match:namespace rofi").

configuration {
    modi: "drun,run,filebrowser,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";   /* Phase 29; falls back to hicolor if Papirus isn't installed */
    display-drun: "Apps";
    display-run: "Run";
    display-filebrowser: "Files";
    display-window: "Windows";
    drun-display-format: "{name}";
    font: "Adwaita Sans, JetBrainsMono Nerd Font Propo 11";   /* Phase 26: icons from the Propo variant */

    /* Phase 18: the highlighted row follows the mouse, and a single click runs
       it. Rofi's defaults were click = select, double-click = run, so the
       highlight only moved on click or scroll. Applies to the launcher and to
       every scripts/rofi-*.sh menu (they import this file). */
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

@theme "/dev/null"

window {
    width: 30%;
    border: 2px;
    border-color: #1793d1;
    border-radius: 10px;
    /* same 0.85-ish alpha as the Waybar pills; Hyprland blurs what's behind */
    background-color: #141414e0;
}

mainbox {
    background-color: transparent;
    padding: 12px;
    children: [ "inputbar", "listview", "mode-switcher" ];
}

inputbar {
    background-color: #1f1f1f;
    text-color: #e0e0e0;
    padding: 10px 12px;
    border-radius: 6px;
    children: [ "entry" ];
}

entry {
    background-color: transparent;
    text-color: #e0e0e0;
    placeholder: "Search apps...";
    placeholder-color: #6e6e6e;
}

listview {
    background-color: transparent;
    margin: 10px 0 0 0;
    lines: 8;
    spacing: 4px;
    scrollbar: false;
}

element {
    background-color: transparent;
    padding: 8px;
    spacing: 10px;
    border-radius: 6px;
    text-color: #e0e0e0;
}

element-icon {
    background-color: transparent;
    size: 26px;
}

element-text {
    background-color: transparent;
    /* follow element's color, so the selected row's color reaches the text */
    text-color: inherit;
    highlight: bold #5db3df;
    vertical-align: 0.5;
}

element selected {
    background-color: #2b2b2b;
    text-color: #1793d1;
}

mode-switcher {
    background-color: transparent;
    spacing: 8px;
    margin: 10px 0 0 0;
}

button {
    border: 0px;
    border-color: transparent;
    padding: 8px;
    background-color: #1f1f1f;
    text-color: #e0e0e0;
    border-radius: 6px;
}

button selected {
    border: 0px;
    background-color: #2b2b2b;
    text-color: #1793d1;
}

