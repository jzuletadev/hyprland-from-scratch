// ~/hyprland-from-scratch/dotfiles/rofi/config.rasi

configuration {
    modi: "drun,run,filebrowser,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "Apps";
    display-run: "Run";
    display-filebrowser: "Files";
    display-window: "Windows";
    drun-display-format: "{name}";
    font: "Adwaita Sans, JetBrainsMono Nerd Font Propo 10";

    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

@theme "/dev/null"
@import "appearance.rasi"

window {
    width: 30%;
    border: @menu-border;
    border-color: @menu-border-color;
    border-radius: 10px;
    background-color: #141414e0;
}

mainbox {
    background-color: transparent;
    padding: 12px;
    children: [ "inputbar", "listview", "mode-switcher" ];
}

inputbar {
    background-color: #1f1f1f;
    text-color: #e0e0e0;
    padding: 10px 12px;
    border-radius: 6px;
    children: [ "entry" ];
}

entry {
    background-color: transparent;
    text-color: #e0e0e0;
    placeholder: "Search apps...";
    placeholder-color: #6e6e6e;
}

listview {
    background-color: transparent;
    margin: 10px 0 0 0;
    lines: 8;
    spacing: 4px;
    scrollbar: false;
}

element {
    background-color: transparent;
    padding: 8px;
    spacing: 10px;
    border-radius: 6px;
    text-color: #e0e0e0;
}

element-icon {
    background-color: transparent;
    size: 26px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: @accent-highlight;
    vertical-align: 0.5;
}

element selected {
    background-color: #2b2b2b;
    text-color: @accent;
}

mode-switcher {
    background-color: transparent;
    spacing: 8px;
    margin: 10px 0 0 0;
}

button {
    border: 0px;
    border-color: transparent;
    padding: 8px;
    background-color: #1f1f1f;
    text-color: #e0e0e0;
    border-radius: 6px;
}

button selected {
    border: 0px;
    background-color: #2b2b2b;
    text-color: @accent;
}

