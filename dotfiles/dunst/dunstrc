# ~/hyprland-from-scratch/dotfiles/dunst/dunstrc
#
# Minimal dunst config — Phase 5 baseline, themed in Phase 10 (Tokyo Night).
# INI-style sections. Kept small on purpose: per-app rules, scripting,
# and history navigation get added later once this base is understood.

[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = 10x10
    width = 320
    height = 100
    font = JetBrainsMono Nerd Font 11
    format = "<b>%s</b>\n%b"
    timeout = 5
    frame_width = 2
    frame_color = "#7aa2f7"
    separator_color = frame
    corner_radius = 10

[urgency_low]
    background = "#1a1b26"
    foreground = "#565f89"
    timeout = 4

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    timeout = 5

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0
