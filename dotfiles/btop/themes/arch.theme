# ~/hyprland-from-scratch/dotfiles/btop/themes/arch.theme
#
# btop theme — Phase 15 (Arch Neutral). Neutral greys with the Arch logo blue;
# gradients go blue (calm) -> amber/red (busy/hot) so load still reads at a glance.
# tokyonight.theme is kept next to it and stays selectable from btop's menu.

theme[main_bg]="#141414"
theme[main_fg]="#e0e0e0"
theme[title]="#1793d1"
theme[hi_fg]="#5db3df"
theme[selected_bg]="#2b2b2b"
theme[selected_fg]="#e0e0e0"
theme[inactive_fg]="#6e6e6e"
theme[graph_text]="#a8a8a8"
theme[meter_bg]="#2b2b2b"
theme[proc_misc]="#5db3df"

theme[cpu_box]="#3a3a3a"
theme[mem_box]="#3a3a3a"
theme[net_box]="#3a3a3a"
theme[proc_box]="#3a3a3a"
theme[div_line]="#2b2b2b"

theme[temp_start]="#1793d1"
theme[temp_mid]="#e0a84e"
theme[temp_end]="#e05f65"

theme[cpu_start]="#1793d1"
theme[cpu_mid]="#45b8d9"
theme[cpu_end]="#e05f65"

theme[free_start]="#141414"
theme[free_mid]="#2b2b2b"
theme[free_end]="#6e6e6e"

theme[cached_start]="#1f4560"
theme[cached_mid]="#1793d1"
